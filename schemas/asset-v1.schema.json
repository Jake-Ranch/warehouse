{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Voxvar shared asset",
  "type": "object",
  "required": [
    "kind",
    "version",
    "name",
    "cellSize",
    "editor"
  ],
  "properties": {
    "kind": {
      "enum": [
        "voxvar.car",
        "voxvar.map"
      ]
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "cellSize": {
      "const": 0.1
    },
    "size": {
      "type": "object",
      "required": [
        "sx",
        "sy",
        "sz"
      ],
      "properties": {
        "sx": {
          "type": "integer",
          "minimum": 1
        },
        "sy": {
          "type": "integer",
          "minimum": 1
        },
        "sz": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "style": {
      "type": "string"
    },
    "targetLaps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "grip": {
      "type": "number",
      "minimum": 0
    },
    "editor": {
      "type": "object"
    }
  }
}